<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Unity'ye bağlı katmanın (Runtime/Unity + örnek) sözdizimi/tür denetimi.
    UnityEngine YERİNE elle yazılmış stub'lar (UnityStubs.cs) kullanılır: API
    imzaları gerçek Unity'yle birebir doğrulanmaz — asıl doğrulama Unity
    Editor'da (bkz. social/README.md › Doğrulama).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1998</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <Compile Include="../../Runtime/**/*.cs" />
    <Compile Include="../../Samples~/**/*.cs" />
  </ItemGroup>
</Project>
