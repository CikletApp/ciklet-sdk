{
  "name": "@ciklet/embedded-activities-sdk",
  "version": "1.1.0",
  "description": "Ciklet Embedded Activities SDK — Build rich, multiplayer experiences as Activities inside Ciklet.",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "import": "./dist/esm/types/index.js",
      "require": "./dist/cjs/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-dist-package-types.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "ciklet",
    "activities",
    "sdk",
    "iframe",
    "embedded"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CikletApp/ciklet-sdk"
  },
  "sideEffects": false
}
